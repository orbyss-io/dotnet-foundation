<Project>
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/feature.json') or Exists('$(MSBuildProjectDirectory)/settings.source.json')">
    <FoundationSettingsMetadataSource Condition="Exists('$(MSBuildProjectDirectory)/settings.source.json')">$(MSBuildProjectDirectory)/settings.source.json</FoundationSettingsMetadataSource>
    <FoundationFeatureDescriptorSource Condition="Exists('$(MSBuildProjectDirectory)/feature.json')">$(MSBuildProjectDirectory)/feature.json</FoundationFeatureDescriptorSource>
    <FoundationBuildTaskAssembly>$(MSBuildThisFileDirectory)src/Orbyss.Foundation.Build/bin/$(Configuration)/net10.0/Orbyss.Foundation.Build.dll</FoundationBuildTaskAssembly>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/feature.json') or Exists('$(MSBuildProjectDirectory)/settings.source.json')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Orbyss.Foundation.Build/Orbyss.Foundation.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="src/Orbyss.Foundation.Build/buildTransitive/Orbyss.Foundation.Build.targets" />
</Project>
