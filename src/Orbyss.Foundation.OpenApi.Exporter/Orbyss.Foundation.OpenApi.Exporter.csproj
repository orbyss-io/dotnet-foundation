<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable Condition="'$(FoundationRuntimeOnly)' == 'true'">false</IsPackable>
    <ExporterVersion>0.2.5</ExporterVersion>
    <Version>$(ExporterVersion)</Version><PackageVersion>$(ExporterVersion)</PackageVersion>
    <OutputType>Exe</OutputType>
    <IsPackable Condition="'$(FoundationRuntimeOnly)' != 'true'">true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orbyss-foundation-openapi-export</ToolCommandName>
    <PackageId>Orbyss.Foundation.OpenApi.Exporter</PackageId>
    <Description>Side-effect-free composed OpenAPI exporter for Orbyss Foundation feature packages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>orbyss-foundation;openapi;cshells;build-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PackageVersion" Value="$(PackageVersion)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
