<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BuildToolsVersion>0.3.1</BuildToolsVersion><Version>$(BuildToolsVersion)</Version><PackageVersion>$(Version)</PackageVersion>
    <Description>Publisher-owned feature descriptors and source-bound settings metadata for Foundation-compatible packages.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput><SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable Condition="'$(FoundationRuntimeOnly)' != 'true'">true</IsPackable>
    <IsPackable Condition="'$(FoundationRuntimeOnly)' == 'true'">false</IsPackable>
    <!-- Build task assemblies intentionally have no consumer lib/ reference. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn><PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework"><HintPath>$(MSBuildBinPath)/Microsoft.Build.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Build.Utilities.Core"><HintPath>$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll</HintPath><Private>false</Private></Reference>
    <None Include="buildTransitive/Orbyss.Foundation.Build.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="tasks/net10.0/" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="$(PkgMicrosoft_CodeAnalysis_CSharp)/ThirdPartyNotices.rtf" Pack="true" PackagePath="notices/Roslyn-ThirdPartyNotices.rtf" />
    <None Include="Roslyn-LICENSE.txt" Pack="true" PackagePath="notices/" />
    <None Include="$(OutputPath)Microsoft.CodeAnalysis.dll" Pack="true" PackagePath="tasks/net10.0/" />
    <None Include="$(OutputPath)Microsoft.CodeAnalysis.CSharp.dll" Pack="true" PackagePath="tasks/net10.0/" />
    <None Include="settings.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="settings-source.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="settings-v2.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="settings-source-v2.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="feature.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="legacy-feature-bridge.json" Pack="true" PackagePath="compatibility/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
