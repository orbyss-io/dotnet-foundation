{
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "packageVersion",
    "sourceSha256",
    "contracts",
    "assembly",
    "imports"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceSha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxProperties": 512
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "owner",
          "scope",
          "complete",
          "sources",
          "settings",
          "semanticConstraints",
          "appliesTo",
          "typeName"
        ],
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "complete": {
            "type": "boolean"
          },
          "sources": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "maxProperties": 512
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "required",
                "secret",
                "constraints",
                "binding",
                "precedence",
                "reload",
                "description",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "required": {
                  "type": "boolean"
                },
                "secret": {
                  "type": "boolean"
                },
                "constraints": {
                  "type": "object"
                },
                "binding": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "precedence": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "minItems": 1,
                  "maxItems": 128
                },
                "reload": {
                  "enum": [
                    "restart",
                    "reload",
                    "immutable"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "default": {
                  "allOf": [
                    {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "maxLength": 16384
                      }
                    },
                    {
                      "if": {
                        "type": "array"
                      },
                      "then": {
                        "maxItems": 256
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "secret": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "default"
                      ]
                    }
                  }
                }
              ]
            },
            "maxItems": 256
          },
          "semanticConstraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "maxItems": 128
          },
          "appliesTo": {
            "type": "object",
            "required": [
              "kind",
              "features",
              "configuration"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "shell",
                  "host",
                  "code"
                ]
              },
              "features": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "configuration": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            "additionalProperties": false
          },
          "typeName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "assembly": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.dll$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "imports": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "typeName",
          "packageId",
          "packageVersion",
          "scope",
          "metadataSha256",
          "assembly"
        ],
        "properties": {
          "typeName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "packageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "packageVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "metadataSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "assembly": {
            "type": "object",
            "required": [
              "name",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+\\.dll$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/foundation/settings-v2.schema.json"
}
