<Project>
  <PropertyGroup>
    <FoundationBuildTaskAssembly Condition="'$(FoundationBuildTaskAssembly)' == ''">$(MSBuildThisFileDirectory)../tasks/net10.0/Orbyss.Foundation.Build.dll</FoundationBuildTaskAssembly>
  </PropertyGroup>
  <UsingTask TaskName="Orbyss.Foundation.Build.EmitFeatureDescriptor" AssemblyFile="$(FoundationBuildTaskAssembly)" />
  <PropertyGroup>
    <FoundationFeatureDescriptor>$(IntermediateOutputPath)orbyss-foundation/feature.json</FoundationFeatureDescriptor>
    <FoundationComposeForOpenApi Condition="'$(FoundationComposeForOpenApi)' == ''">true</FoundationComposeForOpenApi>
    <FoundationFeatureDormant Condition="'$(FoundationFeatureDormant)' == ''">false</FoundationFeatureDormant>
  </PropertyGroup>
  <ItemGroup Condition="'$(FoundationFeatureIdentity)' != '' or '$(FoundationFeatureDescriptorSource)' != ''">
    <None Include="$(FoundationFeatureDescriptor)" Pack="true" PackagePath="orbyss-foundation/feature.json" Visible="false" />
  </ItemGroup>
  <Target Name="FoundationEmitFeatureDescriptor" BeforeTargets="GenerateNuspec" Condition="'$(FoundationFeatureIdentity)' != '' or '$(FoundationFeatureDescriptorSource)' != ''">
    <Orbyss.Foundation.Build.EmitFeatureDescriptor OutputFile="$(FoundationFeatureDescriptor)" Identity="$(FoundationFeatureIdentity)" PackageId="$(PackageId)"
      FeatureDependencies="$(FoundationFeatureDependencies)" RuntimeDependencies="$(FoundationRuntimeDependencies)" Routes="$(FoundationFeatureRoutes)"
      DescriptorSource="$(FoundationFeatureDescriptorSource)" AssetsFile="$(ProjectAssetsFile)"
      ProjectDirectory="$(MSBuildProjectDirectory)" SourceFiles="@(Compile)"
      Dormant="$(FoundationFeatureDormant)" ComposeForOpenApi="$(FoundationComposeForOpenApi)" />
  </Target>
  <UsingTask TaskName="Orbyss.Foundation.Build.EmitSettingsMetadata" AssemblyFile="$(FoundationBuildTaskAssembly)" />
  <PropertyGroup><FoundationSettingsMetadata>$(IntermediateOutputPath)orbyss-foundation/settings.json</FoundationSettingsMetadata></PropertyGroup>
  <ItemGroup Condition="'$(FoundationSettingsMetadataSource)' != ''">
    <None Include="$(FoundationSettingsMetadata)" Pack="true" PackagePath="orbyss-foundation/settings.json" Visible="false" />
  </ItemGroup>
  <Target Name="FoundationCompileSettingsMetadata" AfterTargets="Build" DependsOnTargets="Compile;CopyFilesToOutputDirectory" Condition="'$(FoundationSettingsMetadataSource)' != ''">
    <PropertyGroup>
      <FoundationSettingsDesignTime>false</FoundationSettingsDesignTime>
      <FoundationSettingsDesignTime Condition="'$(DesignTimeBuild)' == 'true'">true</FoundationSettingsDesignTime>
      <FoundationSettingsCompilerSkipped>false</FoundationSettingsCompilerSkipped>
      <FoundationSettingsCompilerSkipped Condition="'$(SkipCompilerExecution)' == 'true'">true</FoundationSettingsCompilerSkipped>
    </PropertyGroup>
    <Orbyss.Foundation.Build.EmitSettingsMetadata DeclarationSource="$(FoundationSettingsMetadataSource)" OutputFile="$(FoundationSettingsMetadata)"
      PackageId="$(PackageId)" PackageVersion="$(PackageVersion)" ProjectDirectory="$(MSBuildProjectDirectory)" SourceFiles="@(Compile)"
      CompiledAssembly="$(TargetPath)" LangVersion="$(LangVersion)" ReferenceFiles="@(ReferencePathWithRefAssemblies)" ImplementationReferenceFiles="@(ReferencePath)" DependencyMetadataFiles="@(FoundationSettingsMetadataDependency)" CompilerExecutionSkipped="$(FoundationSettingsCompilerSkipped)" DesignTimeCompilation="$(FoundationSettingsDesignTime)" />
  </Target>
  <!-- Pack does not run compilation when NoBuild is true. Resolve its compiler-reference inventory
       in a native evaluation that also refuses to build project references. -->
  <Target Name="FoundationResolveSettingsMetadataReferences" DependsOnTargets="FindReferenceAssembliesForReferences"
      Returns="@(ReferencePathWithRefAssemblies)" Condition="'$(FoundationSettingsMetadataSource)' != ''" />
  <Target Name="FoundationResolveSettingsMetadataImplementationReferences" DependsOnTargets="FindReferenceAssembliesForReferences"
      Returns="@(ReferencePath)" Condition="'$(FoundationSettingsMetadataSource)' != ''" />
  <!-- Global using Compile items are normally supplied before compilation. No-build packing
       still needs that exact SDK compiler context, without invoking Compile or project builds. -->
  <Target Name="FoundationEmitSettingsMetadata" BeforeTargets="GenerateNuspec" DependsOnTargets="GenerateGlobalUsings"
      Condition="'$(FoundationSettingsMetadataSource)' != '' and '$(IsPackable)' != 'false'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="FoundationResolveSettingsMetadataReferences"
        Properties="BuildProjectReferences=false" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_FoundationSettingsPackReferences" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="FoundationResolveSettingsMetadataImplementationReferences"
        Properties="BuildProjectReferences=false" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_FoundationSettingsPackImplementationReferences" />
    </MSBuild>
    <PropertyGroup>
      <FoundationSettingsDesignTime>false</FoundationSettingsDesignTime>
      <FoundationSettingsDesignTime Condition="'$(DesignTimeBuild)' == 'true'">true</FoundationSettingsDesignTime>
      <FoundationSettingsCompilerSkipped>false</FoundationSettingsCompilerSkipped>
      <FoundationSettingsCompilerSkipped Condition="'$(SkipCompilerExecution)' == 'true'">true</FoundationSettingsCompilerSkipped>
    </PropertyGroup>
    <Orbyss.Foundation.Build.EmitSettingsMetadata DeclarationSource="$(FoundationSettingsMetadataSource)" OutputFile="$(FoundationSettingsMetadata)"
      PackageId="$(PackageId)" PackageVersion="$(PackageVersion)" ProjectDirectory="$(MSBuildProjectDirectory)" SourceFiles="@(Compile)"
      CompiledAssembly="$(TargetPath)" LangVersion="$(LangVersion)" ReferenceFiles="@(_FoundationSettingsPackReferences)" ImplementationReferenceFiles="@(_FoundationSettingsPackImplementationReferences)" DependencyMetadataFiles="@(FoundationSettingsMetadataDependency)" CompilerExecutionSkipped="$(FoundationSettingsCompilerSkipped)" DesignTimeCompilation="$(FoundationSettingsDesignTime)" PackedFiles="@(_BuildOutputInPackage)" ValidateOnly="true" />
  </Target>
</Project>
