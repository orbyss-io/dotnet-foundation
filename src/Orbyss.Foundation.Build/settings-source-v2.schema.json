{
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "sourceSha256",
    "contracts",
    "imports"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxProperties": 512
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scope",
          "typeName",
          "complete",
          "settings",
          "semanticConstraints",
          "appliesTo"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "typeName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "complete": {
            "type": "boolean"
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "property",
                "path",
                "required",
                "secret",
                "constraints",
                "binding",
                "precedence",
                "reload",
                "description"
              ],
              "properties": {
                "property": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "required": {
                  "type": "boolean"
                },
                "secret": {
                  "type": "boolean"
                },
                "constraints": {
                  "type": "object"
                },
                "binding": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "precedence": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "minItems": 1,
                  "maxItems": 128
                },
                "reload": {
                  "enum": [
                    "restart",
                    "reload",
                    "immutable"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "additionalProperties": false
            },
            "maxItems": 256
          },
          "semanticConstraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "maxItems": 128
          },
          "appliesTo": {
            "type": "object",
            "required": [
              "kind",
              "features",
              "configuration"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "shell",
                  "host",
                  "code"
                ]
              },
              "features": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "configuration": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "imports": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "typeName",
          "packageId",
          "scope"
        ],
        "properties": {
          "typeName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "packageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/foundation/settings-source-v2.schema.json"
}
