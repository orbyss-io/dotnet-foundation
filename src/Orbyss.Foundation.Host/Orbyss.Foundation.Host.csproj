<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Application-neutral Nuplane, CShells, and secure web runtime host for Orbyss Foundation applications.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CShells.AspNetCore" />
    <PackageReference Include="Nuplane" />
    <PackageReference Include="Nuplane.Loading" />
    <PackageReference Include="Nuplane.Sources.Directory" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="hostsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="shells.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".orbyss-foundation\web-profile.shells.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('.orbyss-foundation\web-profile.shells.json')" />
    <Folder Include="packages\" />
  </ItemGroup>
</Project>
