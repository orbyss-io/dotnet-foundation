{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Foundation": {
    "Boot": {
      "EagerShellActivation": true,
      "FailOnShellActivationError": true
    }
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "00:01:00",
      "Feeds": [
        {
          "Name": "local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [ "*" ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:01"
          }
        }
      ]
    },
    "Loading": {
      "Enabled": true,
      "DefaultLoadMode": "HostIntegrated",
      "LoadModeSelectionPolicy": "ExplicitOnly",
      "SharedAssemblies": [
        { "Name": "CShells.Abstractions", "PublicKeyToken": null, "MajorVersion": 0 },
        { "Name": "CShells.AspNetCore.Abstractions", "PublicKeyToken": null, "MajorVersion": 0 }
      ]
    }
  }
}
