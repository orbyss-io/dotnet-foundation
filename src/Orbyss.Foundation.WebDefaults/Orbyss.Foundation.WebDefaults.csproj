<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Replaceable CShells web defaults for localization, HSTS, correlation, and browser headers.</Description>
    <PackageId>Orbyss.Foundation.WebDefaults</PackageId>
    <PackageTags>orbyss-foundation;cshells;aspnetcore;security-headers</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
